# ---------------------------------------------------------------------------
# Variables de entorno de la API de Gestion de Almacen
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48                     # para APP_KEY
#   php artisan key:generate --show
#
# Las variables `ALMACEN_*` son opcionales: si no se definen, se usan los
# valores por omision de `config/almacen.php`.
# ---------------------------------------------------------------------------

APP_NAME="Almacén Hefesto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# El rol de esta conexion NO puede ser superusuario ni tener BYPASSRLS.
# Con cualquiera de las dos, PostgreSQL ignora las politicas de Row Level
# Security y una empresa podria ver los datos de otra. Lo comprueba:
#   php artisan almacen:verificar-aislamiento
DB_CONNECTION=pgsql
DB_DATABASE=almacen
DB_USERNAME=almacen_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=almacen_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en produccion: Redis exige contrasena.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/almacen/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/acceso/callback
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_GRUPO_ADMIN=almacen-administradores
AUTHENTIK_GRUPO_OPERADORES=almacen-operadores

# ---------------------------------------------------------------------------
# Reglas del almacen (opcionales)
# ---------------------------------------------------------------------------
# Horas que queda comprometida la mercaderia antes de volver a estar
# disponible. Es el plazo que evita que un pedido olvidado bloquee el
# stock para siempre.
ALMACEN_HORAS_VALIDEZ_RESERVA=72

# Dias minimos entre dos conteos de la misma zona. El sistema avisa, pero
# no bloquea: esa regla es del jefe de almacen, no del software.
ALMACEN_DIAS_ENTRE_CONTEO=30

# Paradas maximas por oleada de picking. Una vuelta con demasiadas paradas
# se vuelve un brazo muerto de operario.
ALMACEN_PARADAS_MAXIMAS_POR_OLEADA=120